+package org.opensilex.security.service;
+
+import org.opensilex.security.account.dal.AccountModel;
+import org.opensilex.security.group.dal.GroupDAO;
+import org.opensilex.security.group.dal.GroupModel;
+import org.opensilex.security.group.dal.GroupUserProfileModel;
+import org.opensilex.security.profile.dal.ProfileDAO;
+import org.opensilex.security.profile.dal.ProfileModel;
+import org.opensilex.sparql.service.SPARQLService;
+import org.opensilex.sparql.deserializer.SPARQLDeserializers;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Internal service for automatically assigning new OpenID/SAML users to default groups.
+ * Searches for groups and profiles by NAME instead of hardcoded URIs to support any base URI.
+ */
+public class SecurityAutoAssignmentService {
+    private static final Logger LOGGER = LoggerFactory.getLogger(SecurityAutoAssignmentService.class);
+    private static final String DEFAULT_GROUP_NAME = "Users";
+    private static final String DEFAULT_PROFILE_NAME = "Default profile";
+
+    /**
+     * Assign a newly created user to the default Users group if they have no groups.
+     */
+    public static void assignToDefaultGroupIfNew(AccountModel user, SPARQLService sparql) {
+        if (user == null || user.getUri() == null || sparql == null) {
+            return;
+        }
+
+        try {
+            GroupDAO groupDAO = new GroupDAO(sparql);
+
+            // Check if user already has groups
+            List<URI> userGroups = groupDAO.getGroupUriList(user);
+            if (userGroups != null && !userGroups.isEmpty()) {
+                return;  // User already has groups
+            }
+
+            // Search for default group and profile by name
+            GroupModel usersGroup = findGroupByName(groupDAO, DEFAULT_GROUP_NAME);
+            if (usersGroup == null) {
+                LOGGER.warn("Default group '{}' not found. Create it manually in OpenSILEX UI.", DEFAULT_GROUP_NAME);
+                return;
+            }
+
+            ProfileDAO profileDAO = new ProfileDAO(sparql);
+            ProfileModel defaultProfile = findProfileByName(profileDAO, DEFAULT_PROFILE_NAME);
+            if (defaultProfile == null) {
+                LOGGER.warn("Default profile '{}' not found. Create it manually in OpenSILEX UI.", DEFAULT_PROFILE_NAME);
+                return;
+            }
+
+            // Create user-profile link
+            GroupUserProfileModel groupUserProfile = new GroupUserProfileModel();
+            groupUserProfile.setUser(user);
+            groupUserProfile.setProfile(defaultProfile);
+
+            // Add to group
+            List<GroupUserProfileModel> userProfiles = usersGroup.getUserProfiles();
+            if (userProfiles == null) {
+                userProfiles = new ArrayList<>();
+                usersGroup.setUserProfiles(userProfiles);
+            }
+            userProfiles.add(groupUserProfile);
+            groupDAO.update(usersGroup);
+
+            LOGGER.info("Auto-assigned new user {} to '{}' group with '{}' profile",
+                user.getEmail(), DEFAULT_GROUP_NAME, DEFAULT_PROFILE_NAME);
+        } catch (Exception e) {
+            LOGGER.error("Failed to auto-assign user to default group: " + e.getMessage(), e);
+        }
+    }
+
+    /**
+     * Search for a group by name (case-sensitive).
+     * @return GroupModel if found, null otherwise
+     */
+    private static GroupModel findGroupByName(GroupDAO groupDAO, String name) throws Exception {
+        try {
+            List<GroupModel> allGroups = groupDAO.search(
+                name,           // pattern
+                null,           // orderByList
+                null,           // userFilter
+                0,              // page
+                0               // pageSize (0 = all)
+            );
+
+            for (GroupModel group : allGroups) {
+                if (name.equals(group.getName())) {
+                    return group;
+                }
+            }
+        } catch (Exception e) {
+            LOGGER.error("Error searching for group '{}': {}", name, e.getMessage());
+        }
+        return null;
+    }
+
+    /**
+     * Search for a profile by name (case-sensitive).
+     * @return ProfileModel if found, null otherwise
+     */
+    private static ProfileModel findProfileByName(ProfileDAO profileDAO, String name) throws Exception {
+        try {
+            List<ProfileModel> allProfiles = profileDAO.search(name, null, 0, 0);
+
+            for (ProfileModel profile : allProfiles) {
+                if (name.equals(profile.getName())) {
+                    return profile;
+                }
+            }
+        } catch (Exception e) {
+            LOGGER.error("Error searching for profile '{}': {}", name, e.getMessage());
+        }
+        return null;
+    }
+}
