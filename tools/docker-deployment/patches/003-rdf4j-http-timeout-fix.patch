+
+            // Get configured timeout (in seconds), use 300s (5 minutes) default if not set
+            // This prevents socket read timeouts during large ontology queries
+            int timeoutSeconds = config.timeout();
+            if (timeoutSeconds <= 0) {
+                timeoutSeconds = 300; // Default 5 minutes for ontology queries
+                LOGGER.debug("No timeout configured, using default: {} seconds", timeoutSeconds);
+            } else {
+                LOGGER.debug("Using configured timeout: {} seconds", timeoutSeconds);
+            }
+            int timeoutMs = timeoutSeconds * 1000;
+
+            // Configure HTTP client timeouts to prevent EOFException on large responses
+            RequestConfig requestConfig = RequestConfig.custom()
