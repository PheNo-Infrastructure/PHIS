# API Keys and Authentication Configuration Template
# 
# Copy this file to 'api-keys.conf' and add your actual credentials
# 
# IMPORTANT: 
#   - The api-keys.conf file will be ignored by git for security
#   - Never commit actual API keys or credentials to version control
#   - Get your Agroportal API key from: https://agroportal.lirmm.fr/account
#   - Get your FEIDE credentials from: https://dashboard.dataporten.no/
#
# Usage:
#   1. Copy this file: cp api-keys.conf.template api-keys.conf
#   2. Edit api-keys.conf with your actual credentials
#   3. Run the installation script normally
#

# Agroportal API Key (optional - for ontology integration)
AGROPORTAL_API_KEY="your-agroportal-api-key-here"

# FEIDE/Dataporten Credentials (optional - for FEIDE authentication)
# Register your application at: https://dashboard.dataporten.no/
# Set redirect URI to: http://YOUR-VM-IP:8080/app/openid
# Enable attribute groups: email, userinfo-name, userinfo-mail
# Enable scopes: openid, userid, profile, email
FEIDE_CLIENT_ID="your-feide-client-id-here"
FEIDE_CLIENT_SECRET="your-feide-client-secret-here"

# AWS S3 Credentials (optional - for S3 file storage)
# Get your AWS credentials from: https://console.aws.amazon.com/iam/
# Note: AWS_S3_ENDPOINT must include the URI scheme (https://)
AWS_ACCESS_KEY_ID="your-aws-access-key-id-here"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key-here"
AWS_REGION="eu-west-3"
AWS_S3_BUCKET="your-s3-bucket-name-here"
AWS_S3_ENDPOINT="https://s3.eu-west-3.amazonaws.com"

# Future credentials can be added below:
# OTHER_SERVICE_CREDENTIAL="your-other-credential-here"