# OpenSILEX Testing Configuration
#
# Copy this file to test-config.env and update with your deployment details
# Usage: source test-config.env before running tests
#

# ==========================================
# Server Connection Settings
# ==========================================

# SSH connection details for remote testing
export OPENSILEX_SERVER="20.61.108.197"
export OPENSILEX_USER="azureuser"
export OPENSILEX_SSH_KEY="$HOME/.ssh/id_ed25519"

# Deployment directory on remote server
export OPENSILEX_DEPLOY_DIR="~/opensilex-docker-compose"

# ==========================================
# OpenSILEX URL Settings
# ==========================================

# Base URL for OpenSILEX instance (for API testing)
export OPENSILEX_BASE_URL="http://20.61.108.197/sandbox"

# REST API URL
export OPENSILEX_API_URL="http://20.61.108.197/sandbox/rest"

# Web UI URL
export OPENSILEX_WEB_URL="http://20.61.108.197/sandbox/app"

# OpenAPI/Swagger docs URL
export OPENSILEX_API_DOCS_URL="http://20.61.108.197/sandbox/api-docs"

# ==========================================
# Authentication Settings
# ==========================================

# Admin credentials for testing (default OpenSILEX credentials)
export OPENSILEX_ADMIN_EMAIL="admin@opensilex.org"
export OPENSILEX_ADMIN_PASSWORD="admin"

# Test user credentials (optional, for multi-user testing)
export OPENSILEX_TEST_USER_EMAIL="test@example.org"
export OPENSILEX_TEST_USER_PASSWORD="testpassword"

# ==========================================
# Test Behavior Settings
# ==========================================

# Test mode: "remote" (via SSH) or "local" (on same machine as deployment)
export OPENSILEX_TEST_MODE="remote"

# Timeout for API requests (seconds)
export OPENSILEX_API_TIMEOUT=30

# Timeout for SSH connections (seconds)
export OPENSILEX_SSH_TIMEOUT=10

# ==========================================
# Docker Container Names (usually standard)
# ==========================================

export OPENSILEX_MONGODB_CONTAINER="mongodb"
export OPENSILEX_RDF4J_CONTAINER="rdf4j"
export OPENSILEX_APP_CONTAINER="opensilex"
export OPENSILEX_HAPROXY_CONTAINER="haproxy"

# ==========================================
# Performance Test Settings
# ==========================================

# Number of concurrent users for load testing
export OPENSILEX_LOAD_TEST_USERS=50

# Load test spawn rate (users per second)
export OPENSILEX_LOAD_TEST_SPAWN_RATE=5

# Load test duration
export OPENSILEX_LOAD_TEST_DURATION="2m"

# ==========================================
# Database Connection Settings (for integrity tests)
# ==========================================

# MongoDB database name
export OPENSILEX_MONGODB_DATABASE="opensilex"

# RDF4J repository name
export OPENSILEX_RDF4J_REPOSITORY="opensilex"

# ==========================================
# Test Data Settings
# ==========================================

# Prefix for test entities (to avoid conflicts with real data)
export OPENSILEX_TEST_PREFIX="test_automated_"

# Clean up test data after tests (true/false)
export OPENSILEX_CLEANUP_TEST_DATA="true"

# ==========================================
# Reporting Settings
# ==========================================

# Directory for test reports
export OPENSILEX_TEST_REPORTS_DIR="./test-reports"

# HTML report filename
export OPENSILEX_HTML_REPORT="test-report.html"
