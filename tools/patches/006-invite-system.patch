@@ -22,4 +22,5 @@ import org.opensilex.server.ServerModule;
 import org.opensilex.server.exceptions.BadRequestException;
 import org.opensilex.security.account.api.AccountRegisterDTO;
+import org.opensilex.security.service.InviteService;
 import org.opensilex.server.response.*;
 import org.opensilex.server.rest.validation.Required;
@@ -556,4 +556,73 @@ authenticateSAML
         return new ErrorResponse(Status.FORBIDDEN, "Invalid SAML authentication", "Could not authenticate user with SAML")
                 .getResponse();
     }
+
+    // ── Researcher invite ─────────────────────────────────────────────────────
+
+    @POST
+    @Path("invite")
+    @ApiOperation("Invite a researcher by email (admin only)")
+    @ApiResponses({
+        @ApiResponse(code = 200, message = "Invite email sent"),
+        @ApiResponse(code = 403, message = "Admin access required"),
+        @ApiResponse(code = 503, message = "Email service not available")
+    })
+    @Consumes(MediaType.APPLICATION_JSON)
+    @Produces(MediaType.APPLICATION_JSON)
+    public Response invite(
+            @ApiParam(value = "Invite details", required = true) @Valid InviteDTO dto
+    ) throws Exception {
+        if (!currentUser.isAdmin()) {
+            return new ErrorResponse(Response.Status.FORBIDDEN,
+                    "Forbidden", "Admin access required").getResponse();
+        }
+        if (!emailService.isEnable()) {
+            return new ErrorResponse(Response.Status.SERVICE_UNAVAILABLE,
+                    "Functionality not available",
+                    "Email service must be configured to send invites").getResponse();
+        }
+        String token = InviteService.createInvite(dto.getEmail());
+        sendInviteEmail(dto.getEmail(), token);
+        return Response.ok().build();
+    }
+
+    @GET
+    @Path("accept-invite")
+    @ApiOperation("Accept a researcher invite via email link")
+    @ApiResponses({
+        @ApiResponse(code = 200, message = "Invite accepted — log in with Feide to activate researcher access"),
+        @ApiResponse(code = 400, message = "Invalid or already-used invite token")
+    })
+    @Produces(MediaType.APPLICATION_JSON)
+    public Response acceptInvite(
+            @ApiParam(value = "Invite token", required = true)
+            @QueryParam("token") @NotNull String token
+    ) throws Exception {
+        boolean accepted = InviteService.acceptInvite(token);
+        if (!accepted) {
+            return new ErrorResponse(Response.Status.BAD_REQUEST,
+                    "Invalid token", "This invite link is invalid or has already been used").getResponse();
+        }
+        return Response.ok().build();
+    }
+
+    private void sendInviteEmail(String emailAddress, String inviteToken) {
+        try {
+            String baseURL = emailService.getOpenSilex().getModuleByClass(ServerModule.class).getBaseURL();
+            if (!baseURL.endsWith("/")) {
+                baseURL += "/";
+            }
+            String inviteUrl = baseURL + "app/accept-invite/" + inviteToken;
+            Map<String, Object> infos = new HashMap<>();
+            List<InternetAddress> receivers = new LinkedList<>();
+            receivers.add(new InternetAddress(emailAddress));
+            infos.put("inviteUrl", inviteUrl);
+            emailService.sendAnEmail(receivers, "[OpenSILEX] You have been invited as a researcher",
+                    "invite.mustache", infos, true);
+        } catch (Exception e) {
+            LOGGER.error("Failed to send invite email: " + e.getMessage(), e);
+        }
+    }
+
+    // ── Register (patch 005) ──────────────────────────────────────────────────
 }
