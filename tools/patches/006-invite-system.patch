+<template>
+  <div class="container-fluid">
+    <b-row class="justify-content-center" style="margin-top: 80px;">
+      <b-col cols="12" md="6" lg="4">
+        <div class="card p-4 text-center">
+          <div v-if="loading">
+            <p>{{ $t("AcceptInvite.loading") }}</p>
+          </div>
+          <div v-else-if="accepted">
+            <h2 class="text-success mb-3">{{ $t("AcceptInvite.successTitle") }}</h2>
+            <p>{{ $t("AcceptInvite.successMessage") }}</p>
+            <router-link to="/" class="btn btn-primary mt-3">
+              {{ $t("AcceptInvite.loginButton") }}
+            </router-link>
+          </div>
+          <div v-else>
+            <h2 class="text-danger mb-3">{{ $t("AcceptInvite.errorTitle") }}</h2>
+            <p>{{ $t("AcceptInvite.errorMessage") }}</p>
+            <router-link to="/" class="btn btn-secondary mt-3">
+              {{ $t("AcceptInvite.backToLogin") }}
+            </router-link>
+          </div>
+        </div>
+      </b-col>
+    </b-row>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Vue } from "vue-property-decorator";
+
+@Component
+export default class AcceptInvite extends Vue {
+  loading = true;
+  accepted = false;
+
+  async mounted() {
+    const token = this.$route.params.token as string;
+    try {
+      let service = await (this as any).$opensilex.loadService("opensilex-security.AuthenticationService");
+      await service.acceptInvite(token);
+      this.accepted = true;
+    } catch (error) {
+      this.accepted = false;
+    } finally {
+      this.loading = false;
+    }
+  }
+}
+</script>
+
+<style scoped lang="scss"></style>
+
+<i18n>
+en:
+  AcceptInvite:
+    loading: "Accepting your invite..."
+    successTitle: "Invite accepted!"
+    successMessage: "Your researcher access is ready. Log in with Feide to activate it."
+    loginButton: "Log in with Feide"
+    errorTitle: "Invalid invite"
+    errorMessage: "This invite link is invalid or has already been used. Please ask an administrator to resend your invite."
+    backToLogin: "Back to login"
