+package org.opensilex.security.service;
+
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Manages researcher invite tokens (in-memory; cleared on pod restart — resend invite if needed).
+ */
+public class InviteService {
+
+    private static final ConcurrentHashMap<String, String> pendingTokens = new ConcurrentHashMap<>();
+
+    /** Creates an invite token for the given email and returns it. */
+    public static String createInvite(String email) {
+        String token = UUID.randomUUID().toString();
+        pendingTokens.put(token, email.toLowerCase());
+        return token;
+    }
+
+    /** Accepts an invite token: moves the email into the pending-researchers set. Returns false if token is unknown. */
+    public static boolean acceptInvite(String token) {
+        String email = pendingTokens.remove(token);
+        if (email == null) {
+            return false;
+        }
+        SecurityAutoAssignmentService.pendingResearchers.add(email);
+        return true;
+    }
+}
