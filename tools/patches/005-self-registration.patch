+<template>
+  <div class="container-fluid">
+    <b-row class="justify-content-center" style="margin-top: 80px;">
+      <b-col cols="12" md="6" lg="4">
+        <div class="card p-4 text-center">
+          <div v-if="loading">
+            <p>{{ $t("ConfirmRegistration.loading") }}</p>
+          </div>
+          <div v-else-if="confirmed">
+            <h2 class="text-success mb-3">{{ $t("ConfirmRegistration.successTitle") }}</h2>
+            <p>{{ $t("ConfirmRegistration.successMessage") }}</p>
+            <router-link to="/" class="btn btn-primary mt-3">
+              {{ $t("ConfirmRegistration.loginButton") }}
+            </router-link>
+          </div>
+          <div v-else>
+            <h2 class="text-danger mb-3">{{ $t("ConfirmRegistration.errorTitle") }}</h2>
+            <p>{{ $t("ConfirmRegistration.errorMessage") }}</p>
+            <router-link to="/" class="btn btn-secondary mt-3">
+              {{ $t("ConfirmRegistration.backToLogin") }}
+            </router-link>
+          </div>
+        </div>
+      </b-col>
+    </b-row>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Vue } from "vue-property-decorator";
+
+@Component
+export default class ConfirmRegistration extends Vue {
+  loading = true;
+  confirmed = false;
+
+  async mounted() {
+    const token = decodeURIComponent(this.$route.params.token as string);
+    try {
+      let service = await (this as any).$opensilex.loadService("opensilex-security.AuthenticationService");
+      await service.confirmRegistration(token);
+      this.confirmed = true;
+    } catch (error) {
+      this.confirmed = false;
+    } finally {
+      this.loading = false;
+    }
+  }
+}
+</script>
+
+<style scoped lang="scss"></style>
+
+<i18n>
+en:
+  ConfirmRegistration:
+    loading: "Confirming your account..."
+    successTitle: "Account confirmed!"
+    successMessage: "Your account has been activated. You can now log in."
+    loginButton: "Log in"
+    errorTitle: "Invalid link"
+    errorMessage: "This confirmation link is invalid or has expired. Your account is still active — you can log in directly."
+    backToLogin: "Back to login"
+fr:
+  ConfirmRegistration:
+    loading: "Confirmation de votre compte..."
+    successTitle: "Compte confirmé !"
+    successMessage: "Votre compte a été activé. Vous pouvez maintenant vous connecter."
+    loginButton: "Se connecter"
+    errorTitle: "Lien invalide"
+    errorMessage: "Ce lien de confirmation est invalide ou a expiré. Votre compte est toujours actif — vous pouvez vous connecter directement."
+    backToLogin: "Retour à la connexion"
+</i18n>
