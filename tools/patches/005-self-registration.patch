@@ -22,4 +22,5 @@
 import org.opensilex.server.ServerModule;
 import org.opensilex.server.exceptions.BadRequestException;
+import org.opensilex.security.account.api.AccountRegisterDTO;
 import org.opensilex.server.response.*;
 import org.opensilex.server.rest.validation.Required;
@@ -462,4 +462,94 @@ authenticateSAML
         return new ErrorResponse(Status.FORBIDDEN, "Invalid SAML authentication", "Could not authenticate user with SAML")
                 .getResponse();
     }
+
+    @POST
+    @Path("register")
+    @ApiOperation("Register a new account — sends a confirmation email")
+    @ApiResponses({
+        @ApiResponse(code = 200, message = "Confirmation email sent"),
+        @ApiResponse(code = 409, message = "Email already registered"),
+        @ApiResponse(code = 503, message = "Email service not available")
+    })
+    @Consumes(MediaType.APPLICATION_JSON)
+    @Produces(MediaType.APPLICATION_JSON)
+    public Response register(
+            @ApiParam(value = "Registration details", required = true) @Valid AccountRegisterDTO dto
+    ) throws Exception {
+        if (!emailService.isEnable()) {
+            return new ErrorResponse(Response.Status.SERVICE_UNAVAILABLE,
+                    "Functionality not available",
+                    "Email service must be configured to enable self-registration").getResponse();
+        }
+        AccountDAO accountDAO = new AccountDAO(sparql);
+        InternetAddress email;
+        try {
+            email = new InternetAddress(dto.getEmail());
+        } catch (Exception e) {
+            return new ErrorResponse(Response.Status.BAD_REQUEST,
+                    "Invalid email", "The provided email address is not valid").getResponse();
+        }
+        if (accountDAO.getByEmail(email) != null) {
+            return new ErrorResponse(Response.Status.CONFLICT,
+                    "Email already registered",
+                    "An account with this email already exists").getResponse();
+        }
+        String lang = (dto.getLanguage() != null && !dto.getLanguage().isEmpty()) ? dto.getLanguage() : "en";
+        String passwordHash = authentication.getPasswordHash(dto.getPassword());
+        AccountModel account = accountDAO.create(null, email, false, passwordHash, lang, true, null);
+        SecurityAutoAssignmentService.assignToDefaultGroupIfNew(account, sparql);
+        URI confirmToken = authentication.addForgotPasswordId(account.getUri());
+        sendRegistrationConfirmEmail(email.getAddress(), confirmToken);
+        return new ObjectUriResponse(Response.Status.OK, account.getUri()).getResponse();
+    }
+
+    @GET
+    @Path("confirm-registration")
+    @ApiOperation("Confirm account registration via email token")
+    @ApiResponses({
+        @ApiResponse(code = 200, message = "Account confirmed"),
+        @ApiResponse(code = 400, message = "Invalid or expired token")
+    })
+    @Produces(MediaType.APPLICATION_JSON)
+    public Response confirmRegistration(
+            @ApiParam(value = "Confirmation token", required = true)
+            @QueryParam("token") @NotNull @ValidURI URI token
+    ) throws Exception {
+        URI userUri = authentication.getForgottenPasswordUserURIFromRenewToken(token);
+        if (userUri == null) {
+            return new ErrorResponse(Response.Status.BAD_REQUEST,
+                    "Invalid token", "This confirmation link is invalid or has expired").getResponse();
+        }
+        AccountDAO accountDAO = new AccountDAO(sparql);
+        AccountModel account = accountDAO.get(userUri);
+        if (account == null) {
+            return new ErrorResponse(Response.Status.NOT_FOUND,
+                    "Account not found", "Could not find the account for this confirmation link").getResponse();
+        }
+        accountDAO.update(account.getUri(), account.getEmail(), Boolean.TRUE.equals(account.isAdmin()),
+                account.getPasswordHash(), account.getLanguage(), true,
+                account.getLinkedPerson(),
+                account.getFavorites() != null ? account.getFavorites() : new java.util.ArrayList<>());
+        authentication.removeForgottenPasswordUserFromRenewToken(token);
+        return new ObjectUriResponse(Response.Status.OK, userUri).getResponse();
+    }
+
+    private void sendRegistrationConfirmEmail(String emailAddress, URI confirmToken) {
+        try {
+            String baseURL = emailService.getOpenSilex().getModuleByClass(ServerModule.class).getBaseURL();
+            if (!baseURL.endsWith("/")) {
+                baseURL += "/";
+            }
+            String redirectUrl = baseURL + "app/confirm-registration/" + confirmToken.toString();
+            Map<String, Object> infos = new HashMap<>();
+            List<InternetAddress> receivers = new LinkedList<>();
+            receivers.add(new InternetAddress(emailAddress));
+            infos.put("username", emailAddress);
+            infos.put("redirectUrl", redirectUrl);
+            emailService.sendAnEmail(receivers, "[OpenSILEX] Confirm your account",
+                    "register-confirmation.mustache", infos, true);
+        } catch (Exception e) {
+            LOGGER.error("Failed to send registration confirmation email: " + e.getMessage(), e);
+        }
+    }
 }
