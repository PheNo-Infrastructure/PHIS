diff --git a/opensilex-front/front/src/components/layout/Register.vue b/opensilex-front/front/src/components/layout/Register.vue
new file mode 100644
--- /dev/null
+++ b/opensilex-front/front/src/components/layout/Register.vue
@@ -0,0 +1,152 @@
+<template>
+  <div class="container-fluid">
+    <b-row class="justify-content-center" style="margin-top: 80px;">
+      <b-col cols="12" md="6" lg="4">
+        <div class="card p-4">
+          <h2 class="text-center mb-4">{{ $t("Register.title") }}</h2>
+
+          <div v-if="success" class="alert alert-success">
+            {{ $t("Register.successMessage") }}
+            <br/>
+            <router-link to="/">{{ $t("Register.backToLogin") }}</router-link>
+          </div>
+
+          <ValidationObserver v-else ref="validatorRef">
+            <b-form @submit.prevent="onRegister">
+              <ValidationProvider
+                :name="$t('Register.email')"
+                rules="required|email"
+                v-slot="{ errors }"
+              >
+                <b-form-group :label="$t('Register.email')">
+                  <b-form-input
+                    v-model="email"
+                    type="email"
+                    :placeholder="$t('Register.email')"
+                    :state="errors.length > 0 ? false : null"
+                  ></b-form-input>
+                  <b-form-invalid-feedback>{{ errors[0] }}</b-form-invalid-feedback>
+                </b-form-group>
+              </ValidationProvider>
+
+              <ValidationProvider
+                :name="$t('Register.password')"
+                rules="required"
+                v-slot="{ errors }"
+                vid="password-first"
+              >
+                <b-form-group :label="$t('Register.password')">
+                  <b-form-input
+                    v-model="password"
+                    type="password"
+                    :placeholder="$t('Register.password')"
+                    :state="errors.length > 0 ? false : null"
+                  ></b-form-input>
+                  <b-form-invalid-feedback>{{ errors[0] }}</b-form-invalid-feedback>
+                </b-form-group>
+              </ValidationProvider>
+
+              <ValidationProvider
+                :name="$t('Register.confirmPassword')"
+                rules="required|confirmed:password-first"
+                v-slot="{ errors }"
+              >
+                <b-form-group :label="$t('Register.confirmPassword')">
+                  <b-form-input
+                    v-model="confirmPassword"
+                    type="password"
+                    :placeholder="$t('Register.confirmPassword')"
+                    :state="errors.length > 0 ? false : null"
+                  ></b-form-input>
+                  <b-form-invalid-feedback>{{ errors[0] }}</b-form-invalid-feedback>
+                </b-form-group>
+              </ValidationProvider>
+
+              <div v-if="errorMsg" class="alert alert-danger mt-2">{{ errorMsg }}</div>
+
+              <b-button type="submit" variant="primary" class="w-100 mt-2" :disabled="loading">
+                {{ loading ? $t("Register.loading") : $t("Register.submit") }}
+              </b-button>
+            </b-form>
+          </ValidationObserver>
+
+          <p class="text-center mt-3" style="font-size:0.9em;">
+            <router-link to="/">{{ $t("Register.backToLogin") }}</router-link>
+          </p>
+        </div>
+      </b-col>
+    </b-row>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Vue, Ref } from "vue-property-decorator";
+import { ValidationObserver, ValidationProvider } from "vee-validate";
+
+@Component({
+  components: { ValidationObserver, ValidationProvider }
+})
+export default class Register extends Vue {
+  @Ref("validatorRef") readonly validatorRef!: InstanceType<typeof ValidationObserver>;
+
+  email = "";
+  password = "";
+  confirmPassword = "";
+  errorMsg = "";
+  loading = false;
+  success = false;
+
+  async onRegister() {
+    const valid = await this.validatorRef.validate();
+    if (!valid) return;
+    this.loading = true;
+    this.errorMsg = "";
+    try {
+      let service = await (this as any).$opensilex.loadService("opensilex-security.AuthenticationService");
+      await service.register({ email: this.email, password: this.password, language: "en" });
+      this.success = true;
+    } catch (error) {
+      if (error && (error as any).status === 409) {
+        this.errorMsg = this.$t("Register.errorEmailTaken") as string;
+      } else if (error && (error as any).status === 503) {
+        this.errorMsg = this.$t("Register.errorEmailService") as string;
+      } else {
+        this.errorMsg = this.$t("Register.errorGeneric") as string;
+      }
+    } finally {
+      this.loading = false;
+    }
+  }
+}
+</script>
+
+<style scoped lang="scss"></style>
+
+<i18n>
+en:
+  Register:
+    title: "Create an account"
+    email: "Email"
+    password: "Password"
+    confirmPassword: "Confirm password"
+    submit: "Register"
+    loading: "Registering..."
+    successMessage: "Registration successful! Your account is active — you can now log in."
+    backToLogin: "Back to login"
+    errorEmailTaken: "This email address is already registered."
+    errorEmailService: "Email service is unavailable. Please contact an administrator."
+    errorGeneric: "Registration failed. Please try again."
+fr:
+  Register:
+    title: "Créer un compte"
+    email: "Email"
+    password: "Mot de passe"
+    confirmPassword: "Confirmer le mot de passe"
+    submit: "S'inscrire"
+    loading: "Inscription..."
+    successMessage: "Inscription réussie ! Votre compte est actif — vous pouvez vous connecter."
+    backToLogin: "Retour à la connexion"
+    errorEmailTaken: "Cette adresse email est déjà enregistrée."
+    errorEmailService: "Le service email est indisponible. Veuillez contacter un administrateur."
+    errorGeneric: "L'inscription a échoué. Veuillez réessayer."
+</i18n>
