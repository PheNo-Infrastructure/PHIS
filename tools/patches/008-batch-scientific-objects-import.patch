+    @POST
+    @Path("json_import")
+    @ApiOperation("Create many scientific objects from a JSON list")
+    @ApiProtected
+    @ApiCredential(
+            credentialId = CREDENTIAL_SCIENTIFIC_OBJECT_MODIFICATION_ID,
+            credentialLabelKey = CREDENTIAL_SCIENTIFIC_OBJECT_MODIFICATION_LABEL_KEY
+    )
+    @Consumes(MediaType.APPLICATION_JSON)
+    @Produces(MediaType.APPLICATION_JSON)
+    @ApiResponses(value = {
+            @ApiResponse(code = 201, message = "Scientific objects created", response = URI.class, responseContainer = "List"),
+            @ApiResponse(code = 404, message = "Experiment not found", response = ErrorResponse.class)
+    })
+    public Response importScientificObjects(
+            @ApiParam(value = "List of scientific object descriptions", required = true) @NotNull List<ScientificObjectCreationDTO> dtos,
+            @ApiParam(value = "Experiment URI", required = true) @NotNull @ValidURI @QueryParam("experiment") URI experimentURI
+    ) throws Exception {
+        if (dtos == null || dtos.isEmpty()) {
+            return new CreatedUriResponse(Collections.emptyList()).getResponse();
+        }
+        ScientificObjectLogic soLogic = new ScientificObjectLogic(sparql, nosql, fs);
+        ExperimentDAO experimentDAO = new ExperimentDAO(sparql, nosql);
+
+        ExperimentModel experiment = experimentDAO.get(experimentURI, currentUser);
+        if (Objects.isNull(experiment)) {
+            throw new NotFoundURIException("Unknown experiment", experimentURI);
+        }
+
+        List<ScientificObjectModel> models = new ArrayList<>();
+        for (ScientificObjectCreationDTO dto : dtos) {
+            dto.setExperiment(experimentURI);
+            ScientificObjectModel model = dto.newModel();
+            model.setPublisher(currentUser.getUri());
+            model.setPublicationDate(OffsetDateTime.now());
+            sparql.generateUniqueURI(soLogic.getDefaultGraphNode(), model, model, true);
+            models.add(model);
+        }
+
+        soLogic.createWithNoValidations(models, experimentURI);
+        soLogic.copyIntoGlobalGraph(models.stream());
+        experimentDAO.updateExperimentSpeciesFromScientificObjects(experimentURI);
+
+        List<URI> uris = models.stream().map(ScientificObjectModel::getUri).toList();
+        return new CreatedUriResponse(uris).getResponse();
+    }
