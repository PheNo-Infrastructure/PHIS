+  // Reduces a URI to the part after its scheme+host (expanded form) or its prefix (compact form),
+  // so "https://phis.pheno.no/id/profile/x" and "phis:id/profile/x" compare as the same profile.
+  canonicalUri(u: any): string {
+    const s = this.normalizeUri(u);
+    if (!s) {
+      return s;
+    }
+    const schemeIdx = s.indexOf("://");
+    if (schemeIdx !== -1) {
+      const afterScheme = s.substring(schemeIdx + 3);
+      const slashIdx = afterScheme.indexOf("/");
+      return slashIdx !== -1 ? afterScheme.substring(slashIdx + 1) : afterScheme;
+    }
+    const colonIdx = s.indexOf(":");
+    return colonIdx !== -1 ? s.substring(colonIdx + 1) : s;
+  }
+
+  // Resolves a row's raw profile_uri to whichever dropdown option represents the same profile,
+  // so the select shows the right item selected even when the row's URI form differs from the
+  // option's (see profileOptionsWithFallback / canonicalUri above).
+  resolveSelectValue(rawUri: any): string {
+    const canon = this.canonicalUri(rawUri);
+    const match = this.profileOptionsWithFallback.find(
+      option => this.canonicalUri(option.value) === canon
+    );
+    return match ? match.value : this.normalizeUri(rawUri);
+  }
