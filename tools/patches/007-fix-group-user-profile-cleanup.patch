 import org.opensilex.security.group.api.GroupDTO;
 import org.opensilex.security.person.dal.PersonModel;
+import org.opensilex.server.exceptions.NotFoundURIException;
 import org.opensilex.security.profile.dal.ProfileDAO;
 import org.opensilex.security.profile.dal.ProfileModel;
 import org.opensilex.sparql.deserializer.SPARQLDeserializer;
@@ -71,10 +71,30 @@
         sparql.delete(GroupModel.class, groupURI);
     }

-    public GroupModel update(GroupModel group) throws Exception {
-        sparql.update(group);
-        return group;
-    }
+    public GroupModel update(GroupModel group) throws Exception {
+        List<URI> oldGupUris = sparql.searchURIs(GroupUserProfileModel.class, null, (SelectBuilder select) -> {
+            Var gupVar = sparql.getURIFieldVar(GroupUserProfileModel.class);
+            select.addWhere(SPARQLDeserializers.nodeURI(group.getUri()), SecurityOntology.hasUserProfile, gupVar);
+        });
+        sparql.update(group);
+        if (!oldGupUris.isEmpty()) {
+            Set<URI> currentGupUris = new HashSet<>(sparql.searchURIs(GroupUserProfileModel.class, null, (SelectBuilder select) -> {
+                Var gupVar = sparql.getURIFieldVar(GroupUserProfileModel.class);
+                select.addWhere(SPARQLDeserializers.nodeURI(group.getUri()), SecurityOntology.hasUserProfile, gupVar);
+            }));
+            for (URI oldGupUri : oldGupUris) {
+                if (!currentGupUris.contains(oldGupUri)) {
+                    try {
+                        sparql.delete(GroupUserProfileModel.class, oldGupUri);
+                    } catch (NotFoundURIException e) {
+                        // Already removed by the cascadeDelete on GroupModel.userProfiles
+                        // (hasUserProfile is cascadeDelete=true, autoUpdate=true) -- nothing to do.
+                    }
+                }
+            }
+        }
+        return group;
+    }

