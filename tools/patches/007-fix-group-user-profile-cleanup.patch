+    private void cleanOrphanedGroupUserProfiles(URI accountURI) throws Exception {
+        List<URI> gupUris = sparql.searchURIs(GroupUserProfileModel.class, null, (SelectBuilder select) -> {
+            Var gupVar = sparql.getURIFieldVar(GroupUserProfileModel.class);
+            select.addWhere(gupVar, SecurityOntology.hasUser, SPARQLDeserializers.nodeURI(accountURI));
+        });
+        for (URI gupUri : gupUris) {
+            List<URI> parentGroups = sparql.searchURIs(GroupModel.class, null, (SelectBuilder select) -> {
+                Var groupVar = sparql.getURIFieldVar(GroupModel.class);
+                select.addWhere(groupVar, SecurityOntology.hasUserProfile, SPARQLDeserializers.nodeURI(gupUri));
+            });
+            if (parentGroups.isEmpty()) {
+                sparql.delete(GroupUserProfileModel.class, gupUri);
